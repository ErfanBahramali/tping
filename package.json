{
  "name": "@erfan_bahramali/tping",
  "version": "1.1.0",
  "description": "Ping for Telegram Proxies - real MTProto handshake through MTProto (simple, dd, Fake TLS), SOCKS5 and HTTP proxies",
  "keywords": [
    "checker",
    "cli",
    "connection-test",
    "fake-tls",
    "mtproto",
    "mtproxy",
    "network-tool",
    "ping",
    "proxy",
    "socks5",
    "telegram",
    "validator"
  ],
  "author": "Erfan Bahramali",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErfanBahramali/tping.git"
  },
  "bugs": {
    "url": "https://github.com/ErfanBahramali/tping/issues"
  },
  "homepage": "https://github.com/ErfanBahramali/tping#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tping": "dist/index.js"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "clean": "rm -rf dist",
    "prebuild": "bun run clean",
    "build": "tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "bun-types": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
